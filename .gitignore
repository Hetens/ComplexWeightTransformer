# Python / uv
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# marimo
__marimo__/

# Results & data artifacts (keep dir, ignore contents) — except sweep metrics, which are the
# paper's evidence base: track result.json for unity_* runs (small JSON; checkpoints stay ignored)
# and the probe metrics behind the mechanism sections, both weight-level (d160/) and activation-level
# (act/). HTML figures stay ignored; they regenerate from these JSONs.
results/*
!results/.gitkeep
!results/unity_*/
results/unity_*/*
!results/unity_*/result.json
# the block-diagonal activation-probe model is an independent local retrain (the follow-up sweep ran
# with save_model=False), and docs/results.md quotes its seq@24, so its metrics must be checkable too
!results/local_*/
results/local_*/*
!results/local_*/result.json
!results/_figs/
results/_figs/*
!results/_figs/d64/
results/_figs/d64/*
!results/_figs/d64/phase_metrics.json
!results/_figs/d128/
results/_figs/d128/*
!results/_figs/d128/phase_metrics.json
!results/_figs/d160/
results/_figs/d160/*
!results/_figs/d160/phase_metrics.json
!results/_figs/act/
results/_figs/act/*
!results/_figs/act/activation_metrics.json
!results/_figs/clock/
results/_figs/clock/*
!results/_figs/clock/clock_metrics.json
!results/_figs/clock/clock_metrics_10k.json
# the d64 (2-layer) and d128 (4-layer) probe runs: same rule as unity_*, metrics tracked and
# checkpoints ignored. These two scales were reported as unreproducible in an earlier draft; the
# runs were recovered, so all three probe scales now regenerate from the committed files.
!results/probe_*/
results/probe_*/*
!results/probe_*/result.json
!results/probe2_*/
results/probe2_*/*
!results/probe2_*/result.json
# round three (scripts/unity_clock.sbatch): checkpointed reverse retrains for the clock-causal probe,
# and the 30k-step training-duration control. Same rule: metrics tracked, checkpoints ignored.
!results/clock_*/
results/clock_*/*
!results/clock_*/result.json
!results/long_*/
results/long_*/*
!results/long_*/result.json
experiments/data/cache/
*.pt
*.ckpt

# Weights & Biases (local run cache; sync to the cloud instead of committing)
wandb/

# LaTeX build artifacts (keep sources, ignore the build)
paper/*.aux
# main.bbl is NOT ignored: arXiv does not run bibtex, so the .bbl must ship with the source
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/main.pdf

# Claude Code local (machine-specific permissions etc.)
.claude/settings.local.json

# OS
.DS_Store

# Paper sources are kept out of this repo; it holds the reproduction code only.
paper/
