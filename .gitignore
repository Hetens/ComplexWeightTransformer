# Python / uv
__pycache__/
*.py[cod]
.venv/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# marimo
__marimo__/

# Results & data artifacts (keep dir, ignore contents) — except sweep metrics, which are the
# paper's evidence base: track result.json for unity_* runs (small JSON; checkpoints stay ignored)
# and the probe metrics behind the mechanism sections, both weight-level (d160/) and activation-level
# (act/). HTML figures stay ignored; they regenerate from these JSONs.
results/*
!results/.gitkeep
!results/unity_*/
results/unity_*/*
!results/unity_*/result.json
# the block-diagonal activation-probe model is an independent local retrain (the follow-up sweep ran
# with save_model=False), and docs/results.md quotes its seq@24, so its metrics must be checkable too
!results/local_*/
results/local_*/*
!results/local_*/result.json
!results/_figs/
results/_figs/*
!results/_figs/d160/
results/_figs/d160/*
!results/_figs/d160/phase_metrics.json
!results/_figs/act/
results/_figs/act/*
!results/_figs/act/activation_metrics.json
experiments/data/cache/
*.pt
*.ckpt

# Weights & Biases (local run cache; sync to the cloud instead of committing)
wandb/

# LaTeX build artifacts (keep sources, ignore the build)
paper/*.aux
# main.bbl is NOT ignored: arXiv does not run bibtex, so the .bbl must ship with the source
paper/*.blg
paper/*.fdb_latexmk
paper/*.fls
paper/*.log
paper/*.out
paper/*.synctex.gz
paper/*.toc
paper/main.pdf

# Claude Code local (machine-specific permissions etc.)
.claude/settings.local.json

# OS
.DS_Store
