{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify:quick && next build",
    "start": "next start",
    "lint": "eslint",
    "verify": "npm run verify:bundle && node scripts/.verify.mjs",
    "verify:quick": "npm run verify:bundle && node scripts/.verify.mjs --quick",
    "verify:bundle": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=scripts/.verify.mjs --log-level=warning"
  },
  "dependencies": {
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
